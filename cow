#!/usr/bin/env bash
#
# codex-on-wechat launcher.
#
# Usage:
#   ./cow          # run the bot
#   ./cow run      # run the bot
#   ./cow login    # log in to WeChat and save credentials
#   ./cow logout   # delete saved WeChat credentials
#   ./cow logs 300 # dump the newest 300 persistent log lines
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

if ! command -v uv >/dev/null 2>&1; then
    echo "==> 'uv' not found, installing it (https://docs.astral.sh/uv/)"
    curl -LsSf https://astral.sh/uv/install.sh | sh

    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

    if ! command -v uv >/dev/null 2>&1; then
        echo "error: uv installation failed or is not on PATH. Install it manually from https://docs.astral.sh/uv/ and re-run this script." >&2
        exit 1
    fi
fi

command="${1:-run}"
shift || true

case "$command" in
    run)
        uv sync --extra test
        exec uv run src/codex_wechat_bot.py "$@"
        ;;
    login)
        uv sync --extra test
        exec uv run src/codex_wechat_bot.py --login "$@"
        ;;
    logout)
        uv sync --extra test
        exec uv run src/codex_wechat_bot.py --logout "$@"
        ;;
    logs)
        lines="${1:-200}"
        if [[ "$lines" == *[!0-9]* || "$lines" == "0" ]]; then
            echo "usage: ./cow logs [positive-line-count]" >&2
            exit 2
        fi
        log_file="${CODEX_WECHAT_LOG:-${HOME}/.codex-wechat-bot/logs/codex-wechat.log}"
        if [[ ! -f "$log_file" ]]; then
            echo "runtime log not found: $log_file" >&2
            exit 1
        fi
        exec tail -n "$lines" -- "$log_file"
        ;;
    -h|--help|help)
        sed -n '3,11p' "$0"
        ;;
    *)
        echo "unknown command: $command" >&2
        echo "usage: ./cow [run|login|logout|logs [lines]]" >&2
        exit 2
        ;;
esac
